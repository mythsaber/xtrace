bpf_text = """
#include <uapi/linux/ptrace.h>

/* FRAME_*_OFF / FRAME_PROP*_N / LIST_DEQ_SIZE_OFF 这些帧结构成员偏移和数组长度,
 * 以及 PLUGIN_ID_OFF, 都不在这里写死: 由 build_layout_defines() 查 libAntares 的
