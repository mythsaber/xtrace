 *
 * 这里**没有**帧属性索引: 属性数组整块搬进 event, 由 Python 按帧类型挑列。 */

/* 帧数据缓冲区大小读出来的值大过这个数, 说明取到的不是缓冲区大小(被 hook 的
 * 二进制与头文件不同修订时可能发生), 输出哨兵值而不是垃圾数字 */
#define SIZE_LIMIT              (1ULL << 31)
#define SIZE_INVALID            0xffffffffULL

/* libstdc++ std::deque 的 _M_start / _M_finish 偏移和别的帧结构成员一样由
 * build_layout_defines() 注入 —— 它们也是成员偏移, DWARF 里有。
 * "每块几个元素"则哪里都没有, 由 proc_antares_list() 从活的 deque 里量,
 * 见那边的 block_bytes。 */

struct event {
    u64 timestamp;          /* bpf_ktime_get_ns(), 内核单调时钟, ns */
    u64 qlen;               /* 本次调用时帧链上共有多少帧 */
    u64 data_size;          /* 帧数据缓冲区大小 */
    u32 enter;              /* 1 = 函数入口, 0 = 函数返回值 */
    u32 process_id;
    u32 tid;
    u32 type;               /* Antares_type_t; Antares_type_e 里没有 FRAME_TYPE 这一项,
                             * 它取自 AntaresFrame::type_ 这个独立成员, 不是属性元素 */
    /* 两个属性数组**整块**搬过来, 由 Python 侧按帧类型决定显示哪些列。
     * 数组长度不写死: FRAME_PROP32_N / FRAME_PROP64_N 由 build_layout_defines()
     * 从 DWARF 取, 并与枚举里的 MAX_FRAME_ELEMENT / MAX_FRAME_ELEMENT64 对齐过。 */
    s32 prop32[FRAME_PROP32_N];
    s64 prop64[FRAME_PROP64_N];
    char id[128];
};

BPF_PERF_OUTPUT(events);
BPF_ARRAY(m_event, struct event, 1);

/* 入口 probe 按线程缓存组件的 hdl: uretprobe 拿不到第 1 个参数,
 * --ret 1 时出口事件靠它把组件 id 找回来。条数以线程数为界, 不做删除。 */
BPF_HASH(hdl_by_tid, u32, u64, 4096);

/* 低版本内核需要这么做 */
#define bpf_probe_read_user bpf_probe_read
#define bpf_probe_read_user_str bpf_probe_read_str

static inline u64 get_antares_list_size(u64 list)
{
    u64 size = 0;
    /* Antares_frame_list_::deqFrameSize (在 infoFrameSize 之后) */
    bpf_probe_read_user(&size, sizeof(size), (void *)(list + LIST_DEQ_SIZE_OFF));
    return size;
}

static inline u32 get_antares_frame_type(u64 frame)
{
    u32 value = 0;
    bpf_probe_read_user(&value, sizeof(value), (void *)(frame + FRAME_TYPE_OFF));
    return value;
}

static inline u64 get_antares_frame_data_addr(u64 frame)
{
    u64 data = 0;
    bpf_probe_read_user(&data, sizeof(data), (void *)(frame + FRAME_DATA_OFF));
    return data;
}

static inline u32 get_antares_frame_data_size(u64 data)
{
    u32 value = 0;
    /* AntaresFrameData::buf_size_ */
    bpf_probe_read_user(&value, sizeof(value), (void *)(data + FRAME_DATA_SIZE_OFF));
    return value;
}

/* 组件 id 的取值路径 (Antares_define.h: Antares_plugin_id_interface):
 *     hdl + PLUGIN_ID_OFF -> Antares_plugin_id_handle -> + 8 -> id 字符串
 * 同一个指针的 +0 是组件 name。
 *
 * PLUGIN_ID_OFF 是**编译这条 C 之前**按 --func 推出的模块名查表定下来的: 组件类带
 * 虚析构函数时 vptr 占 +0, 约定里"第一个数据成员就是 id 句柄"因此落在 +8, 但析构
 * 非虚的组件在 +0、个别组件在别处(表见脚本顶部的 PLUGIN_ID_OFF_BY_MODULE)。
 * 这个宏由 build_layout_defines() 注入, 不是这里写死的。 */
static inline void read_plugin_id(u64 hdl, char *id, int len)
{
    u64 id0 = 0, id1 = 0;
    if (hdl == 0)
        return;
    bpf_probe_read_user(&id0, sizeof(id0), (void *)(hdl + PLUGIN_ID_OFF));
    bpf_probe_read_user(&id1, sizeof(id1), (void *)(id0 + 8));
    bpf_probe_read_user_str(id, len, (void *)id1);
}

/* 把这一帧的类型、数据大小和两个属性数组填进 event。调用前 struct event 必须已经
 * 清零: 读失败的 bpf_probe_read_user 不保证写目标, 靠 memset 兜成 0, 而 perf_submit
 * 会拷贝整个结构, 未初始化的填充字节还会泄漏内核栈内容。
 *
 * 属性按**整块**读, 不是逐个属性读: 每个 bpf_probe_read_user 都要写目的指针 + 长度
 * + 地址(约 6~8 条指令), 而上面那个 #pragma unroll 会展开成 MAX_FRAMES_PER_CALL 份。
 * 逐个属性读 33 列 * 16 帧 * ~8 条 直接顶穿 4096 指令预算。整块读每帧只要 2 次调用
 * (48*4 + 14*8 = 304 字节), 而且"显示哪几列"是随帧类型变的, 那个判断在 C 里做不出来
 * —— 交给 Python。 */
static inline void fill_frame(u64 f, struct event *e)
{
    u64 data = 0;
    u64 buf_size = 0;

    e->type = get_antares_frame_type(f);

    /* prop32_ 的元素是 int(有符号), GetProp32 交出的也是 int, 所以按 s32 读: 读成
     * u32 的话插件 SetProp32(prop, -1) 会打成 4294967295 —— 头文件对 FRAME_DELETE /
     * FRAME_KEY_FLAG / FRAME_FORCE_IDR 只说"非0表示…", 没把负数排除在外。
     * prop64_ 一直是 s64, 没这个问题。 */
    bpf_probe_read_user(e->prop32, sizeof(e->prop32), (void *)(f + FRAME_PROP32_OFF));
    bpf_probe_read_user(e->prop64, sizeof(e->prop64), (void *)(f + FRAME_PROP64_OFF));

    data = get_antares_frame_data_addr(f);
    if (data != 0)
        buf_size = get_antares_frame_data_size(data);
    if (buf_size > SIZE_LIMIT)
        buf_size = SIZE_INVALID;
    e->data_size = buf_size;
}

/* enter / exit 两条路径都汇流到这里: 帧链在 PARM2 (入口) 或返回值 (出口) 上 */
static inline void proc_antares_list(struct pt_regs *ctx, u64 hdl, u64 list,
                                     struct event *e)
{
    u64 base = 0;
    void *cur = 0, *first = 0, *last = 0;
    void **node = 0;
    void *f_cur = 0;
    void **f_node = 0;

    if (list == 0)
        return;

    read_plugin_id(hdl, e->id, sizeof(e->id));

    /* 帧链上一共多少帧; 也是"16 帧上限有没有截断"的唯一指示 */
    e->qlen = get_antares_list_size(list);
    e->timestamp = bpf_ktime_get_ns();

    base = list;
    if (bpf_probe_read_user(&cur,   8, (void *)(base + DEQ_START_OFF + 0)))  return;
    if (bpf_probe_read_user(&first, 8, (void *)(base + DEQ_START_OFF + 8)))  return;
    if (bpf_probe_read_user(&last,  8, (void *)(base + DEQ_START_OFF + 16))) return;
    if (bpf_probe_read_user(&node,  8, (void *)(base + DEQ_START_OFF + 24))) return;

    if (bpf_probe_read_user(&f_cur,  8, (void *)(base + DEQ_FINISH_OFF + 0)))  return;
    if (bpf_probe_read_user(&f_node, 8, (void *)(base + DEQ_FINISH_OFF + 24))) return;

    /* 一整块的字节数。不写死也不查 DWARF(那个"_GLIBCXX_DEQUE_BUF_SIZE / sizeof(元素)"
     * 的编译期常量没有成员承载), 而是从这条链自己量: _M_start._M_first 永远指块首,
     * _M_last 又被 libstdc++ 赋成 _M_first + _S_buffer_size(), 所以这个差不随链上
     * 有几帧变, 恒等于一块的大小。两个值上面本来就读了, 这里不额外读内存。 */
    u64 block_bytes = (u64)((char *)last - (char *)first);

#pragma unroll
    for (int i = 0; i < MAX_FRAMES_PER_CALL; i++)
    {
        if (cur == f_cur && node == f_node)
            break;

        /* f 故意留 0 初值: 读取失败时靠它挡掉已释放/无效的帧 */
        u64 f = 0;
        (void)bpf_probe_read_user(&f, 8, cur);
        if (f != 0)
        {
            fill_frame(f, e);
            events.perf_submit(ctx, e, sizeof(*e));
        }

        cur = (void *)((char *)cur + 8);
        if (cur == last)
        {
            /* 当前块到底了, 顺着 _M_start._M_node 走到下一个块 */
            void **next_node = (void **)((char *)node + sizeof(void *));
            void *new_first = 0;
            if (bpf_probe_read_user(&new_first, 8, next_node)) break;
            node = next_node;
            first = new_first;
            last = (void *)((char *)first + block_bytes);
            cur = first;
        }
    }
}

int handle_list_enter(struct pt_regs *ctx)
{
    u64 pid_tgid = bpf_get_current_pid_tgid();
    u32 tid = pid_tgid & 0xffffffff;
    u32 pid = pid_tgid >> 32;
    u64 h = PT_REGS_PARM1(ctx);
    u64 f = PT_REGS_PARM2(ctx);
    u32 key = 0;
    struct event *e = 0;

    if (h == 0 || f == 0)
        return 0;

    /* 缓存 hdl 必须先做, 不管这次要不要提交事件 */
    hdl_by_tid.update(&tid, &h);

    if (!EMIT_ON_ENTER)
        return 0;

    e = m_event.lookup(&key);
    if (e == 0)
        return 0;

    __builtin_memset(e, 0, sizeof(*e));
    e->process_id = pid;
    e->tid = tid;
    e->enter = 1;
    proc_antares_list(ctx, h, f, e);
    return 0;
}

int handle_list_exit(struct pt_regs *ctx)
{
    u64 pid_tgid = bpf_get_current_pid_tgid();
    u32 tid = pid_tgid & 0xffffffff;
    u32 pid = pid_tgid >> 32;
    u64 f = PT_REGS_RC(ctx);
    u32 key = 0;
    struct event *e = 0;
    u64 *h = 0;

    if (f == 0)
        return 0;

    e = m_event.lookup(&key);
    if (e == 0)
        return 0;

    __builtin_memset(e, 0, sizeof(*e));
    e->process_id = pid;
    e->tid = tid;
    e->enter = 0;

    h = hdl_by_tid.lookup(&tid);
    proc_antares_list(ctx, h ? *h : 0, f, e);
    return 0;
}

"""

# ===========================================================================
# 枚举表: 从 <脚本目录>/lib/libAntares.so 的 DWARF 里提取
# ===========================================================================
#
# 下面几个是 DWARF 里的枚举名。缺任何一个都直接报错 —— 这几个是"没有就干不了活"的:
# 两个属性枚举决定列索引, Antares_type_e 决定帧类型。
#
# 只列**必需**的。查名字要用的那批枚举(Antares_csp_e / Antares_sample_fmt_e /
# Antares_codec_id_e ...)不在这里, 而是由 FRAME_PROPERTY_COLUMNS 第 3 列现推 ——
# 见 enum_tags()。写死一份就会和表脱节。
REQUIRED_ENUMS = (
    "frame_property_e",
    "frame_property64_e",
    "Antares_type_e",
)

# 帧类型那一列查名字用的 tag
TYPE_ENUM_TAG = "Antares_type_e"


def enum_tags():
    """要 gdb 去 DWARF 里查的枚举名。

    必需的那几个 + FRAME_PROPERTY_COLUMNS 第 3 列里写过的所有 tag。"""
    names = list(REQUIRED_ENUMS)
    for col in FRAME_PROPERTY_COLUMNS:
        if col[2] and col[2] not in names:
            names.append(col[2])
    return names

GDB_DWARF_SCRIPT = '''import gdb, json

SO = %(so)s
TAGS = %(tags)s
OFFSETS = %(offsets)s
COUNTS = %(counts)s
SIZE_TYPE = %(size_type)s

gdb.execute("set pagination off")
gdb.execute('file "' + SO + '"')

enums = {}
for tag in TAGS:
    try:
        t = gdb.lookup_type(tag)
    except Exception:
        continue
    # 头文件里枚举常常是 "typedef enum X_e {..} X_t;" 这种写法, 于是
    # gdb.lookup_type 给回的是 typedef 而不是 enum 本身(它的 tag 还可能带尾下划线,
    # 如 Antares_color_range_)。剥掉 typedef 再判, 这样 TS 里写的 tag 名和 typedef
    # 名两种写法都能取到 —— 我们按请求的那个名字记, 不按真实 tag 名。
    try:
        t = t.strip_typedefs()
    except Exception:
        pass
    if t.code != gdb.TYPE_CODE_ENUM:
        continue
    enums[tag] = [[f.name, int(f.enumval)] for f in t.fields()]

# 成员偏移。&((T *)0)->m 在 gdb 里算出来就是该成员相对类型起始的偏移,
# 私有成员也读得到; 转成 long 是因为 gdb.Value 的指针不能直接 int()。
# 拼字符串而不用百分号格式化: 本脚本自己是被百分号格式化拼出来的, 里面若再出现
# 百分号会和外面的占位符打架(实测会报 "not enough arguments for format string")。
layout = {}
for tname, member, mac in OFFSETS:
    try:
        expr = "(long)&((" + tname + " *)0)->" + member
        layout[mac] = int(gdb.parse_and_eval(expr))
    except Exception:
        pass

# 数组元素个数 = sizeof(成员) / sizeof(成员[0])。用成员自身的元素类型而不是
# sizeof(int), 免得元素类型变了(比如 int -> int64_t)在这里悄悄算错。
for tname, member, mac in COUNTS:
    try:
        elem = "sizeof(((" + tname + " *)0)->" + member + "[0])"
        if int(gdb.parse_and_eval(elem)) <= 0:
            continue
        total = "sizeof(((" + tname + " *)0)->" + member + ")"
        layout[mac] = int(gdb.parse_and_eval(total)) // int(gdb.parse_and_eval(elem))
    except Exception:
        pass

try:
    layout["FRAME_SIZE"] = int(gdb.parse_and_eval("sizeof(" + SIZE_TYPE + ")"))
except Exception:
    pass

print("@@@XTRACE_ENUMS@@@")
print(json.dumps({"enums": enums, "layout": layout}))
print("@@@XTRACE_END@@@")
'''

ENUM_BEGIN = "@@@XTRACE_ENUMS@@@"
ENUM_END = "@@@XTRACE_END@@@"

# POSIX ERE 的元字符。不用 re.escape: bcc 用的是 POSIX 正则, 不是 Python 的 re,
# 而 re.escape 会多转义 - & ~ # 和空格这类 POSIX ERE 里没有意义的字符
# (\_ \& 在 POSIX ERE 里是未定义行为)。符号名走这里, 只转义真正有意义的。
ERE_META = ".^$*+?()[]{}|\\"


def die(msg):
    sys.stderr.write("error: %s\n" % msg)
    sys.stderr.flush()
    sys.exit(1)


def to_text(raw):
    """子进程管道读出来是 bytes; 解码失败也不能让工具崩在报错信息上。"""
    return raw.decode("utf-8", "replace") if isinstance(raw, bytes) else raw


def find_antares_lib():
    """枚举表的唯一来源: <脚本目录>/lib/ 下的 libAntares.so。

    找固定位置而不是做成命令行参数: 部署约定就是它一定在那儿, 多一个参数就多一种
    "拿别的库跑出错的偏移" 的用法。"""
    exact = os.path.join(SCRIPT_DIR, "lib", "libAntares.so")
    if os.path.exists(exact):
        return exact
    # 软链接没建时退回 glob, 免得工具只因为少一条 ln 就完全不能用
    hits = sorted(glob.glob(LIB_GLOB))
    if not hits:
        die("找不到 libAntares.so。\n"
            "  试过: %s\n"
            "        %s\n"
            "  本工具按部署约定从脚本所在目录的 lib/ 下读 enum, 请把 libAntares.so\n"
            "  和它的软链接 lib/libAntares.so 放到那里。"
            % (exact, LIB_GLOB))
    return hits[0]


def extract_dwarf(so_path):
    """跑一次 gdb, 把需要的枚举表和帧结构成员偏移从 DWARF 里读出来。

    枚举和偏移同一次调用拿完: gdb 打开 10MB 的 .so 本身约 0.2s, 多问几项几乎不额外花时间。"""
    script = GDB_DWARF_SCRIPT % {
        "so": repr(so_path),
        "tags": repr(enum_tags()),
        "offsets": repr(FRAME_OFFSETS),
        "counts": repr(FRAME_COUNTS),
        "size_type": repr(FRAME_SIZE_TYPE),
    }

    fd, script_path = tempfile.mkstemp(prefix="xtrace-gdb-", suffix=".py")
    try:
        with os.fdopen(fd, "w") as fp:
            fp.write(script)
        try:
            proc = subprocess.Popen(
                ["gdb", "-batch", "-nx", "-ex", "set confirm off",
                 "-ex", "set pagination off", "-x", script_path],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            out, err = proc.communicate()
        except OSError as exc:
            die("调不起 gdb (%s)。\n"
                "  本工具每次运行都用 gdb 从 %s 的 DWARF 里读枚举表和帧属性索引,\n"
                "  没有别的来源, 所以目标机上必须装 gdb。" % (exc, so_path))
    finally:
        try:
            os.unlink(script_path)
        except OSError:
            pass

    text = to_text(out)
    begin = text.find(ENUM_BEGIN)
    end = text.find(ENUM_END, begin + 1) if begin >= 0 else -1
    if begin < 0 or end < 0:
        die("gdb 没能输出枚举表 (%s 被 strip 了, 或者根本不是 ELF?)。\n"
            "  gdb stderr:\n%s" % (so_path, to_text(err)[-2000:]))
    data = json.loads(text[begin + len(ENUM_BEGIN):end])
    return data["enums"], data["layout"]


def check_required_enums(enums, source_desc):
    """缺任何一个必要的枚举都直接报错, 不静默降级。"""
    missing = [t for t in REQUIRED_ENUMS if not enums.get(t)]
    if missing:
        die("从 %s 里读不到这些枚举: %s\n"
            "  该文件是不是被 strip 了, 或者不是这份代码编出来的?"
            % (source_desc, ", ".join(missing)))


def check_layout(layout, enums, source_desc):
    """布局闸门: 抓帧前把关。

    现在偏移都是从同一份 DWARF 读的,
    所以闸门查**自洽性**: DWARF 里 prop32_/prop64_ 的元素个数, 必须等于枚举里
    的 MAX_FRAME_ELEMENT / MAX_FRAME_ELEMENT64。不等就说明枚举和结构体不是同一份
    头文件编出来的, 按枚举索引去读数组会越界。"""
    missing = [mac for _, _, mac in FRAME_OFFSETS if mac not in layout]
    missing += [mac for _, _, mac in FRAME_COUNTS if mac not in layout]
    if "FRAME_SIZE" not in layout:
        missing.append(FRAME_SIZE_TYPE)
    if missing:
        die("从 %s 的 DWARF 里读不到这些帧布局信息: %s\n"
            "  该文件是不是被 strip 了, 或者不是这份代码编出来的?"
            % (source_desc, ", ".join(missing)))

    for tag, enum_member, mac in ENUM_ARRAY_PAIRS:
        declared = dict(enums[tag]).get(enum_member)
        derived = layout[mac]
        if declared != derived:
            die("%s 的 %s 是 %s, 但 DWARF 里对应数组的元素个数是 %d (来自 %s)。\n"
                "  枚举和结构体不是同一份头文件编出来的 —— 按枚举索引读这个数组会越界,\n"
                "  所以停在这里。请确认部署的 libAntares 与头文件是同一修订。\n"
                "  新的枚举表还是照常写在 %s 里, 可以先看那个。"
                % (tag, enum_member, declared, derived, source_desc, ENUM_DUMP_NAME))


def format_layout(layout, enums, source_desc, id_off, id_src):
    """把读到的帧布局打成一行行 stderr, 供人工核对。

    这是取代 DATA_PTR_OFF = 392 那个经验值的关键: 换一台机器、换一份 libAntares,
    这里显示的就是那份二进制的真实布局, 不用再去翻头文件推算、也不用猜。

    id_off / id_src 是组件 id 那个偏移和它的出处 —— 上面几行都来自 DWARF, 只有它
    来自脚本里的表"""
    off = dict((mac, layout[mac]) for _, _, mac in FRAME_OFFSETS)
    return ("帧布局(从 %s 的 DWARF 读):\n"
            "    sizeof(%s) = %d\n"
            "    type_   +%-4d  prop32_ +%-4d (x%d)  prop64_ +%-4d (x%d)\n"
            "    data_   +%-4d  AntaresFrameData::buf_size_ +%d\n"
            "    Antares_frame_list_::deqFrameSize +%d\n"
            "    std::deque 帧链: _M_start +%d  _M_finish +%d  (每块几个元素运行时从 deque 量)\n"
            "    组件 id: hdl +%-4d (%s)\n"
            "    frame_property_e->MAX_FRAME_ELEMENT=%s、frame_property64_e->MAX_FRAME_ELEMENT64=%s"
            % (source_desc, FRAME_SIZE_TYPE, layout["FRAME_SIZE"],
               off["FRAME_TYPE_OFF"], off["FRAME_PROP32_OFF"], layout["FRAME_PROP32_N"],
               off["FRAME_PROP64_OFF"], layout["FRAME_PROP64_N"],
               off["FRAME_DATA_OFF"], off["FRAME_DATA_SIZE_OFF"],
               off["LIST_DEQ_SIZE_OFF"],
               off["DEQ_START_OFF"], off["DEQ_FINISH_OFF"], id_off, id_src,
               dict(enums["frame_property_e"]).get("MAX_FRAME_ELEMENT"),
               dict(enums["frame_property64_e"]).get("MAX_FRAME_ELEMENT64")))


def format_c_enum(tag, pairs):
    """按 C 的写法打印, 方便和 Antares_frame_define.h 直接对拍。
    连续的隐式值不写 "= N"(这正是 C 的语义), 也让"中间插入属性"导致的索引平移
    一眼可见: 本来没有 = N 的地方会突然冒出一个。

    只写 enum 不写收尾的 typedef 别名: 别名纯粹是装饰, 而且**头文件里根本没有
    统一的规律** —— 多数是 "typedef enum X_e {..} X_t;", 但 Antares_info_type_e
    的 tag 和 typedef 同名, Antares_color_range_e 的 tag 叫 Antares_color_range_。
    写死一条推导规则就一定会对不上几个, 不如不写, 这样所有枚举一视同仁。"""
    lines = ["    enum %s" % tag, "    {"]
    prev = None
    for i, (name, val) in enumerate(pairs):
        if i == 0 or val != prev + 1:
            lines.append("        %s = %d," % (name, val))
        else:
            lines.append("        %s," % name)
        prev = val
    lines.append("    };")
    return "\n".join(lines)


def dump_enums(enums, stream):
    """把**本工具用到的全部**枚举落下来。

    这里必须用 enum_tags() 而不是 REQUIRED_ENUMS: 后者只是"没有就干不了活"的那三个,
    而查名字用的那一批(Antares_csp_e / Antares_sample_fmt_e / Antares_codec_id_e ...)
    同样是从这个文件里读的, 漏掉它们等于对拍时少了一半依据。"""
    first = True
    for tag in enum_tags():
        if not enums.get(tag):
            # 表里 tag 写错、或这个版本确实没这个类型: 抓帧那边已经就那一列告警过, 这里不重复
            continue
        if not first:
            stream.write("\n")
        stream.write(format_c_enum(tag, enums[tag]) + "\n")
        first = False


def write_enum_dump(enums, path, source_desc):
    """每次运行都把读到的枚举表落到 <脚本目录>/xtrace.enum。

    这是"工具认的枚举"的唯一可查记录: 事后怀疑某列错位时, 直接和
    Antares_frame_define.h 对拍这个文件就够了, 不用重跑。
    写不进去不致命(只读挂载点等), 退回打到 stderr, 信息不丢。"""
    try:
        with open(path, "w") as fp:
            fp.write("# xtrace 从 %s 读到的枚举表\n" % source_desc)
            fp.write("# 与 Antares_frame_define.h 对拍用; 列出本工具用到的全部枚举"
                     "(必需的三个 + 表里点过名的), 空行分隔\n")
            fp.write("# 只写 enum 本身, 不写头文件收尾的那个 typedef 别名 —— 别名的"
                     "命名在头文件里没有统一规律, 硬凑反而对不上\n\n")
            dump_enums(enums, fp)
    except (IOError, OSError) as exc:
        sys.stderr.write("WARNING: 写不了 %s (%s), 枚举表改打到 stderr\n"
                         % (path, exc))
        dump_enums(enums, sys.stderr)
        sys.stderr.flush()
        return
    sys.stderr.write("枚举表来源: %s\n" % source_desc)
    sys.stderr.write("枚举表已写入: %s\n" % path)
    sys.stderr.flush()


def build_layout_defines(layout, id_off):
    """把帧结构的偏移/数组长度生成 #define。

    前两批从 DWARF 读;
    最后 PLUGIN_ID_OFF 读不到, 是按 --func 推出的模块名查表来的 —— 单独一段,
    别和上面混。"""
    lines = []
    for _, _, macro in FRAME_OFFSETS:
        lines.append("#define %-22s %d" % (macro, layout[macro]))
    for _, _, macro in FRAME_COUNTS:
        lines.append("#define %-22s %d" % (macro, layout[macro]))
    lines.append("")
    lines.append("/* 下面这个不是从 DWARF 读的, 是按模块名查 PLUGIN_ID_OFF_BY_MODULE 来的 */")
    lines.append("#define %-22s %d" % ("PLUGIN_ID_OFF", id_off))
    return "\n".join(lines) + "\n"


def build_name_maps(enums):
    # 值 -> 枚举名, 按枚举 tag 索引
    return {tag: {value: name for name, value in pairs}
            for tag, pairs in enums.items()}


def build_frame_columns(enums):
    """把 FRAME_PROPERTY_COLUMNS 落到这次运行的 DWARF 上, 返回 (列, 告警文本)。

    每个列是 dict:
        name   表头里的列名, 就是属性名
        kind   "int"/"int64"/"enum"
        cell   (数组, 索引), 数组是 "p32"/"p64"
        tag    查名字用的枚举 tag, 只有 kind == "enum" 有
        cats   适用帧类型的集合

    列序 = 表里的行序(标了 x 的不进来) + DWARF 里多出来的属性(排在最后)。
    """
    arrays = (("p32", dict(enums["frame_property_e"])),
              ("p64", dict(enums["frame_property64_e"])))
    known = set(NOT_A_PROPERTY)
    columns, warn = [], []

    for name, kind, tag, cats in FRAME_PROPERTY_COLUMNS:
        if name in known:
            # 表是手写的, 同一个属性写两遍就会产出两个同名表头列, 而输出里看不出来
            warn.append("表里 %s 写了不止一遍, 第二行(及以后)忽略" % name)
            continue
        known.add(name)
        if cats == "x":
            # 哪类帧都不显示: 不进输出, 留在表里只为把名字认下来, 免得被当成新属性
            continue

        hit = [(arr, table[name]) for arr, table in arrays if name in table]
        if not hit:
            #不在DWARF里的两个属性枚举里
            continue

        bad = set(cats) - set(CATEGORIES)
        if bad:
            warn.append("表中 %s 适用的帧类型是 %s, 里面有不认识的标志 %s "
                        "(只认 %s 和 x), 忽略该未知标志"
                        % (name, cats, CATEGORIES))
        col = {"name": name, "kind": kind, "cell": hit[0],
               "cats": set(cats) & set(CATEGORIES)}
        if kind == "enum":
            if tag in enums:
                col["tag"] = tag
            else:
                # 留错了 tag 要报警: 不报的话这一列会一直打数字, 看着像"上游没设值"
                warn.append("表中 %s 预按 %s 打枚举名, 但 DWARF 里没有这个类型, "
                            "退化成打数字" % (name, tag))
                col["kind"] = "int"
        columns.append(col)

    # 表里没有、DWARF 里有的属性 -> 所有帧类型都显示, 打数字。按属性索引排序, 顺序稳定。
    extra = []
    for arr, table in arrays:
        for member in sorted(table, key=lambda m: (table[m], m)):
            if member in known or member.startswith("MAX_FRAME_ELEMENT"):
                continue
            known.add(member)
            extra.append((arr, member, table[member]))
    for arr, member, index in extra:
        columns.append({"name": member,
                        "kind": "int64" if arr == "p64" else "int",
                        "cell": (arr, index),
                        "cats": set(CATEGORIES)})
    if extra:
        warn.append("DWARF 里出现了FRAME_PROPERTY_COLUMNS表里没有的帧属性: %s，"
                    "为美化显示，考虑将其补充到表里"
                    % ", ".join(m for _, m, _ in extra))

    return columns, warn


def build_type_categories(enums):
    """帧类型数值 -> 类别字母。按**枚举名**对, 不按数值: 头文件里加一个类型, 数值整体
    平移了也不会认错。不在 TYPE_CATEGORIES 里的类型(NONE/IMAGE/TEXT/INFO/STREAM_END,
    以及头文件里将来新加的)走 UNKNOWN_CATEGORY。"""
    by_name = dict(enums[TYPE_ENUM_TAG])
    out = {}
    for cat, names in TYPE_CATEGORIES:
        for name in names:
            if name in by_name:
                out[by_name[name]] = cat
    return out


def build_header(columns):
    return " ".join([HEADER_PREFIX] + [c["name"] for c in columns] + ["id"])


def read_cell(event, cell):
    arr, index = cell
    return event.prop32[index] if arr == "p32" else event.prop64[index]


def format_cell(col, event):
    """按列的定义取值并排版。kind 决定怎么打, 和"这一帧是不是这类"无关 ——
    那个判断在 print_event 里(不适用就打 "-")。"""
    value = read_cell(event, col["cell"])
    if col["kind"] == "enum":
        return enum_name(name_maps[col["tag"]], value)
    return value


def enum_name(value_map, value):
    """查不到就写 UNKNOWN(v): 沿用 gdb_pretty_printer_AntaresFrame.py 的约定,
    无空格, 不破坏"列之间用空格分隔"的结构, awk 依然可用。"""
    name = value_map.get(value)
    return name if name is not None else "UNKNOWN(%s)" % value


def plugin_modules():
    """Plugins/ 下所有模块名(插件文件名去掉 .apf.<版本>), 仅用于报错时给候选建议。"""
    mods = []
    for path in glob.glob(PLUGIN_GLOB):
        name = os.path.basename(path)
        if ".apf." in name:
            mods.append(name.split(".apf.")[0])
    return sorted(set(mods))


def suggest(typo, candidates):
    """拼错的模块名/函数名给一行候选, 免得用户去 ls Plugins/ 一个个对。"""
    close = difflib.get_close_matches(typo, candidates, n=5, cutoff=0.6)
    if close:
        return "\n  你是不是想传: %s" % ", ".join(close)
    return ""


def find_frame_symbol(plugin, module):
    """在插件自己的符号表里找源码级名字等于 '<模块名>_frame' 的那个函数,
    返回挂 probe 用的 mangled 名(实测 bcc 的 sym_re 匹配的是 ELF 里的 mangled 名)。

    Itanium ABI 下 mangled 形如 _Z<长度><名字><签名>, static 再多一个 L;
    C 编译出来的插件则是裸名。按长度前缀取名字比对、签名原样保留 —— 这样
    不依赖具体签名(实测 57 个插件全是 PvS_, 但换个签名这里依然成立),
    也不需要解名工具。

    只做**精确**匹配, 不做子串: 同插件里 ts_muxer_info_frame / ts_muxer_obj_frame
    这类同样以 <模块名> 开头的干扰符号极多(ts_muxer 里有 6 个以 _frame 结尾的),
    子串匹配会挂错函数。"""
    func = module + FRAME_SUFFIX
    base = os.path.basename(plugin)
    try:
        proc = subprocess.Popen(["nm", "--defined-only", plugin],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, _ = proc.communicate()
    except OSError as exc:
        die("需要 nm (binutils) 来在插件里定位符号: %s" % exc)

    hits = []
    for line in to_text(out).splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3 or parts[1] not in "TtWw":
            continue
        symbol = parts[2].split("@")[0]        # 去掉 sym@@VER 的版本后缀
        if symbol == func:                     # C 插件: 裸名
            hits.append(symbol)
            continue
        match = re.match(r"^_ZL?(\d+)", symbol)
        if match is None:
            continue
        size = int(match.group(1))
        body = symbol[match.end():]
        if len(body) >= size and body[:size] == func:
            hits.append(symbol)

    if not hits:
        die("Plugins/%s 的符号表里没有 '%s' —— 这个插件没遵守 <模块名>_frame 约定,\n"
            "  或者它不是 C/C++ 编出来的帧处理函数。\n"
            "  用 'nm --defined-only Plugins/%s | grep _frame' 看它有什么。"
            % (base, func, base))
    if len(hits) > 1:
        die("Plugins/%s 里有 %d 个 '%s', 无法确定挂哪个:\n%s"
            % (base, len(hits), func,
               "\n".join("    " + h for h in sorted(hits))))
    return hits[0]


def plugin_id_off(module):
    """由模块名查组件 id 句柄的偏移, 返回 (偏移, 出处说明)。

    出处说明只用于 stderr 那个布局块 —— 表里命中的和吃默认值的要能一眼分开:
    前者是查过的, 后者是"没查过这个组件, 按多数情况猜的"。"""
    if module in PLUGIN_ID_OFF_BY_MODULE:
        return PLUGIN_ID_OFF_BY_MODULE[module], "%s.apf 查表" % module
    return PLUGIN_ID_OFF_DEFAULT, "%s.apf 查表" % module


def resolve_plugin(func):
    """由 --func 定位插件, 返回 (插件路径, mangled 符号名, 模块名)。

    命名约定(实测 57/57 成立): 各插件的帧处理函数都叫 <模块名>_frame, 插件文件
    叫 <模块名>.apf.<版本>。所以 --func 本身就唯一确定了插件 —— 不去别的插件里
    找, 也正因如此 --func 只能是字面函数名, 不能是正则(正则推不出模块名)。

    模块名也一并交出去: 它同时是查 PLUGIN_ID_OFF_BY_MODULE 的键, 调用方别再从
    func 里切一次。

    这也让错误更早、更准: 'ff_demuxer_frame' 只会去看 ff_demuxer.apf.*,
    不会像以前那样扫 57 个插件的 12 万个符号然后报"匹配到 393 个"。"""
    if not func.endswith(FRAME_SUFFIX) or func == FRAME_SUFFIX:
        die("--func 必须形如 <模块名>_frame, 由 '%s' 推不出模块名。%s"
            % (func, suggest(func, [m + FRAME_SUFFIX for m in plugin_modules()])
               or "\n  它得是某个插件的帧处理函数本身, 比如 ff_demuxer_frame。"))

    module = func[:-len(FRAME_SUFFIX)]
    hits = sorted(glob.glob(os.path.join(SCRIPT_DIR, "Plugins", module + ".apf.*")))
    if not hits:
        # 候选也要给成 --func 能直接用的形态(带 _frame), 不然给了 'ts_muxer' 也没法用
        die("Plugins/ 下没有 '%s.apf.*' —— 由 --func '%s' 推出的模块名是 '%s'。%s"
            % (module, func, module,
               suggest(module, [m + FRAME_SUFFIX for m in plugin_modules()])
               or "\n  用 ls Plugins/ 看一眼有哪些插件。"))
    if len(hits) > 1:
        die("Plugins/ 下有 %d 个 '%s.apf.*', 无法确定用哪个:\n%s\n"
            "  同一个模块只留一个版本再跑。"
            % (len(hits), module,
               "\n".join("    " + os.path.basename(h) for h in hits)))

    plugin = hits[0]
    symbol = find_frame_symbol(plugin, module)
    sys.stderr.write("--func '%s' -> Plugins/%s  (符号 %s)\n"
                     % (func, os.path.basename(plugin), symbol))
    return plugin, symbol, module


def ere_quote(text):
    return "".join("\\" + c if c in ERE_META else c for c in text)


parser = argparse.ArgumentParser(description="xtrace",
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=examples)

parser.add_argument("-f", "--func", required=True,
                    help="帧处理函数名, 必须形如 <模块名>_frame(如 ff_demuxer_frame)。"
                         "工具由它推出 Plugins/<模块名>.apf.* 并在其中找精确同名符号, "
                         "所以只能是字面名、不能写正则, 也不必写 mangled 名")
parser.add_argument("-i", "--id", default=None,
                    help="组件 ID, 精确匹配 Antares_plugin_id_handle->id; 不设置则捕获所有组件")
parser.add_argument("-r", "--ret", type=int, default=0,
                    help="hook 函数返回值(返回值同样是帧链), 默认 0 = hook 入口")

args = parser.parse_args()

# 枚举表和帧结构偏移都只有一处来源, 每次运行都重新读一遍(0.2s,
# 不做缓存 —— 缓存换来的是"陈旧布局"这个新失败面)。
# 读到的枚举表写进 xtrace.enum 供事后对拍。
source_desc = find_antares_lib()
enums, layout = extract_dwarf(source_desc)
check_required_enums(enums, source_desc)
write_enum_dump(enums, ENUM_DUMP_PATH, source_desc)
check_layout(layout, enums, source_desc)

# 先定位插件再打布局块 —— 组件 id 的偏移按模块名查表, 不先知道模块名就没法填那一行。
plugin_path, symbol, module = resolve_plugin(args.func)
id_off, id_src = plugin_id_off(module)

# 把读到的布局打出来: 换一份 libAntares 就会显示另一组偏移, 一眼能看出是不是换了修订。
sys.stderr.write(format_layout(layout, enums, source_desc, id_off, id_src) + "\n")

name_maps = build_name_maps(enums)
frame_columns, column_warns = build_frame_columns(enums)
frame_categories = build_type_categories(enums)

for text in column_warns:
    sys.stderr.write("WARNING: " + text + "\n")
sys.stderr.flush()

# 编译期开关和帧结构偏移都用前置 #define 注入, 不用占位符替换: 漏替换会让 C 编译不过。
# EMIT_ON_ENTER 为 0 时入口 probe 只缓存 hdl 不提交事件。
bpf_text = ("#define EMIT_ON_ENTER %d\n"
            "#define MAX_FRAMES_PER_CALL %d\n"
            % (0 if args.ret else 1, MAX_FRAMES_PER_CALL)
            + build_layout_defines(layout, id_off) + bpf_text)

b = BPF(text=bpf_text, cflags=["-fno-jump-tables", "-fno-asynchronous-unwind-tables"])

# 入口 probe 恒挂(--ret 1 时它负责缓存 hdl); --ret 1 再挂出口 probe
b.attach_uprobe(name=plugin_path, sym_re="^" + ere_quote(symbol) + "$",
                fn_name="handle_list_enter", pid=-1)
if args.ret == 1:
    b.attach_uretprobe(name=plugin_path, sym_re="^" + ere_quote(symbol) + "$",
                       fn_name="handle_list_exit", pid=-1)

matched = b.num_open_uprobes()
expected = 2 if args.ret == 1 else 1
if matched == 0:
    # nm 里看得见、bcc 却挂不上: 说明 bcc 不认这个符号(比如它只扫 .dynsym,
    # 而 static 局部符号只在 .symtab)。
    sys.stderr.write("error: 在 %s 上挂 probe 失败 —— nm 找得到符号 %s, "
                     "bcc 却一个都没挂上\n" % (plugin_path, symbol))
    sys.exit(1)
elif matched > expected:
    # 理论上不可能: 上面已经用 ^符号$ 精确锚定了。真出现说明 bcc 的匹配语义
    # 不是整串匹配(重复挂载会让同一次调用被打印多次, 开销也翻倍)。
    sys.stderr.write("WARNING: 实际挂载 %d 个 probe, 预期 %d 个。\n"
                     "  已按 '^%s$' 精确匹配, 仍多挂上说明这个 bcc 版本的 sym_re "
                     "语义和预期不同, 结果里可能有重复行。\n"
                     % (matched, expected, symbol))


# --id 过滤放在 Python 侧: BPF 里做字符串比较在 4096 指令预算下不划算。
# 代价是未命中的事件也会走 perf buffer, 所以页数要开大一点。
# 命中/未命中只在退出时统计一次(report_stats), 过程中不打扰。
stats = {
    "printed": 0,
    "lost": 0,
    "id_hit": 0,
    "id_miss": 0,
    "qlen_warned": False,
}


def get_plugin_id(event):
    """取组件 ID。event.id 是 ctypes 的定长字符数组, 直接 str() 会得到
    "b'...'" 或 ctypes 自己的表示, 所以按字节取, 再在第一个 NUL 处截断。"""
    raw = event.id
    if not isinstance(raw, (bytes, str)):
        try:
            raw = bytes(memoryview(raw))
        except TypeError:
            # 兜底: 认不出来的类型退回 str, 至少不要在这里抛异常
            raw = str(raw)
    if isinstance(raw, bytes):
        raw = raw.decode("utf-8", "replace")
    return raw.split("\x00")[0]


def print_event(event):
    # 列是**定宽**的: 按 FRAME_PROPERTY_COLUMNS 全量排一遍, 对当前帧类型不适用的那一列
    # 打 "-", 而不是把这一格省掉。一个 demuxer 的帧链上视频/音频/字幕帧是混着的,
    # 行宽随类型伸缩的话日志就没法对齐着看, awk 的列号也不稳定。
    #
    # prop32 在 BPF 侧是 s32, 所以插件设的 -1 会原样打成 -1, 不会被截成 4294967295
    # (str() 是有符号的)。
    cat = frame_categories.get(event.type, UNKNOWN_CATEGORY)
    row = [
        "enter" if event.enter else "exit",
        event.timestamp,
        event.process_id,
        event.tid,
        event.qlen,
        enum_name(name_maps[TYPE_ENUM_TAG], event.type),
        event.data_size,
    ]
    for col in frame_columns:
        row.append(format_cell(col, event) if cat in col["cats"] else "-")
    row.append(get_plugin_id(event))
    sys.stdout.write(" ".join(str(v) for v in row) + "\n")
    # 重定向到文件时 stdout 是全缓冲的, 不 flush 的话 Ctrl-C 会丢掉最后一段
    sys.stdout.flush()


def warn_qlen(event):
    stats["qlen_warned"] = True
    sys.stderr.write("WARNING: 有帧链长度 %d 超过上限 %d, 只记录了前 %d 帧"
                     "(qlen 列是链的真实长度)\n"
                     % (event.qlen, MAX_FRAMES_PER_CALL, MAX_FRAMES_PER_CALL))
    sys.stderr.flush()


def cb(cpu, data, size):
    event = b["events"].event(data)

    if args.id is not None:
        if get_plugin_id(event) != args.id:
            stats["id_miss"] += 1
            return
        stats["id_hit"] += 1

    if event.qlen > MAX_FRAMES_PER_CALL and not stats["qlen_warned"]:
        warn_qlen(event)

    stats["printed"] += 1
    print_event(event)


def lost_cb(*args):
    # 静默丢事件是这个工具最坏的失败模式, 一定要让用户看到。
    # 不同 bcc 版本这个回调的参数不一样(有的是丢弃计数, 有的是 cpu + 丢弃计数),
    # 取最后一个整数参数; 认不出来就按 1 条计。
    lost = 1
    for arg in reversed(args):
        if isinstance(arg, int) and not isinstance(arg, bool):
            lost = arg
            break
    stats["lost"] += lost


def report_stats():
    """退出时打一次。--id 的过滤结果**只在这里体现**, 过程中不告警 ——
    命中 0 条时这个数就是判断 ID 写错/偏移不对的依据。"""
    sys.stdout.flush()
    msg = ""
    if stats["lost"] > 0:
        msg += ("丢掉了 %d 条事件(perf buffer 溢出), 结果不完整\n" % stats["lost"])
    if args.id is not None:
        msg += ("--id %s: 命中 %d 条, 未命中 %d 条\n"
                % (args.id, stats["id_hit"], stats["id_miss"]))
    if msg:
        sys.stderr.write(msg)
        sys.stderr.flush()


def on_signal(signum, frame):
    report_stats()
    sys.exit(0)


signal.signal(signal.SIGINT, on_signal)
signal.signal(signal.SIGTERM, on_signal)

b["events"].open_perf_buffer(cb, page_cnt=64, lost_cb=lost_cb)

print(build_header(frame_columns))
sys.stdout.flush()

while True:
    b.perf_buffer_poll()
